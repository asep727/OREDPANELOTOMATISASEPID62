# Secret aplikasi. WAJIB di production agar enkripsi credential konsisten dan aman.
APP_SECRET=ganti-dengan-secret-random-panjang

# Vercel / serverless persistence.
# Jika kedua variabel ini diisi, aplikasi memakai Turso melalui SQL over HTTP tanpa package tambahan.
TURSO_DATABASE_URL=libsql://database-anda.turso.io
TURSO_AUTH_TOKEN=token-database-anda

# Local / Pterodactyl hosting only. Default: ./data/asep-bot.sqlite
# DATABASE_PATH=./data/asep-bot.sqlite

# Port untuk hosting Node biasa biasanya disuntikkan otomatis oleh provider.
# PORT=3000

# Jika source diubah dan ingin build ulang saat restart di panel hosting:
# REBUILD=1

# URL publik toko, opsional untuk integrasi eksternal.
PUBLIC_SITE_URL=https://veve.vercel.app
NEXT_PUBLIC_SITE_URL=https://veve.vercel.app
